# FlowGuard Environment Variables

# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api

# Database
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowguard?schema=public"

# Database dialect: "postgres" or "sqlite" (auto-fallback if postgres is unavailable in local dev)
DB_DIALECT=postgres
SQLITE_DB_PATH="./flowguard.db"

# Idempotency
IDEMPOTENCY_EXPIRY_SECONDS=86400

# Retries
DEFAULT_MAX_RETRIES=3
DEFAULT_INITIAL_BACKOFF_MS=500
DEFAULT_BACKOFF_MULTIPLIER=2

# External Dependency Simulation
SIMULATION_LATENCY_MS=100
SIMULATION_FAILURE_MODE=NONE

# Frontend
VITE_API_URL=http://localhost:4000/api

